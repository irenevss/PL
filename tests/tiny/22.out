<program>
<dectype>
tArbol
:
<pointer>
tNodo
;
<dectype>
tNodo
:
<record>
nombre
:
<string>
;
izq
:
tArbol
;
der
:
tArbol
<end_record>
;
<dectype>
tListaNombres
:
<record>
nombres
:
<array>
[
50
]
<of>
<string>
;
cont
:
<int>
<end_record>
;
<decvar>
nombres
:
tListaNombres
;
<decvar>
arbol
:
tArbol
;
<decproc>
lee_nombres
(
<ref>
nombres
:
tListaNombres
)
<decvar>
i
:
<int>
--
<output>
'Introduce el número de nombres a ordenar (max 50): \n'
;
<input>
nombres
.
cont
;
<while>
(
nombres
.
cont
<
0
)
|
(
nombres
.
cont
>
50
)
:
<output>
'Introduce el número de nombres a ordenar (max 50): \n'
;
<input>
nombres
.
cont
<end_while>
;
i
:=
0
;
<output>
'Introduce un nombre en cada línea: \n'
;
<while>
i
<
nombres
.
cont
:
<input>
nombres
.
nombres
[
i
]
;
i
:=
i
+
1
<end_while>
<end_proc>
;
<decproc>
construye_arbol
(
)
<decvar>
i
:
<int>
;
<decproc>
inserta_nombre
(
<ref>
arbol
:
tArbol
)
<if>
arbol
=
<null>
:
<new>
arbol
;
arbol
->
nombre
:=
nombres
.
nombres
[
i
]
;
arbol
->
izq
:=
<null>
;
arbol
->
der
:=
<null>
<else>
<block>
<decvar>
padre
:
tArbol
;
<decvar>
act
:
tArbol
;
<decvar>
fin
:
<bool>
--
padre
:=
<null>
;
act
:=
arbol
;
fin
:=
<false>
;
<while>
!
fin
:
padre
:=
act
;
<if>
act
->
nombre
<
nombres
.
nombres
[
i
]
:
act
:=
act
->
der
<else>
<if>
act
->
nombre
>
nombres
.
nombres
[
i
]
:
act
:=
act
->
izq
<end_if>
<end_if>
;
<if>
act
=
<null>
:
fin
:=
<true>
<else>
<if>
act
->
nombre
=
nombres
.
nombres
[
i
]
:
fin
:=
<true>
<end_if>
<end_if>
<end_while>
;
<if>
act
=
<null>
:
<if>
padre
->
nombre
<
nombres
.
nombres
[
i
]
:
<new>
padre
->
der
;
padre
->
der
->
nombre
:=
nombres
.
nombres
[
i
]
;
padre
->
der
->
izq
:=
<null>
;
padre
->
der
->
der
:=
<null>
<else>
<new>
padre
->
izq
;
padre
->
izq
->
nombre
:=
nombres
.
nombres
[
i
]
;
padre
->
izq
->
izq
:=
<null>
;
padre
->
izq
->
der
:=
<null>
<end_if>
<end_if>
<end_block>
<end_if>
<end_proc>
--
arbol
:=
<null>
;
i
:=
0
;
<while>
i
<
nombres
.
cont
:
@
inserta_nombre
(
arbol
)
;
i
:=
i
+
1
<end_while>
<end_proc>
;
<decproc>
escribe_nombres
(
arbol
:
tArbol
)
<if>
arbol
<>
<null>
:
@
escribe_nombres
(
arbol
->
izq
)
;
<output>
arbol
->
nombre
;
<output>
'\n'
;
@
escribe_nombres
(
arbol
->
der
)
<end_if>
<end_proc>
--
@
