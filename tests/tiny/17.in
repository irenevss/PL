## Programa con seccion de declaraciones y seccion de instrucciones
program
  decvar x : int;
  decvar y : real;
  decvar z: bool
  --
  x := y = z;
  x := x = (false < (z <= (k >= (true > (10 <> 5)))));
  x := 5 - 6 + 7  + 8 + 9;
  x := x & (y & (z | k));
  x := x * y / z * 6e56;
  x := ! (- (! (- - (! x))));
  x := ((true | false) & (5 - 6) * 7)=a
end_program  
