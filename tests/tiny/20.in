## Entrada sintacticamente valida para los analizadores de Tiny
program
dectype tRaro:
   array [20] of
     pointer pointer record
                     x: int;
 	                 y: bool;
 	                 z: real;
					 k: record 
					      u: pointer array [20] of array [30] of int
					    end_record
                  end_record;   						
dectype  tRarito: array [5] of array [10] of pointer pointer tRaro;
decvar x: array [10] of  array [10] of pointer pointer pointer tRarito;

decproc subprog(x: int, y: pointer pointer tRarito, ref z: record x: int; y: pointer tRarito end_record) 
   decvar k: pointer pointer tRarito;
   decproc u(v: int, ref z: array [98] of int)
   end_proc
   --
   *(*(k.c).x[e+e[x.c]].y[r]) % 2 := x->u[y->v];
   @ u(5, 5 - 5);
   if x = 34 :
    if x < 56 :
     x := x + 1;
	 while x < 20: 
	  block
	   decvar x: int
	   --
	   x := 2*x;
	   x := 5
   	  end_block
	 end_while 
	end_if  
   else 
    block  
     decproc y() end_proc
  	  --
      x := 2 * y;
   	  @ y(2*x + 80, 45 - x)
    end_block
   end_if   
end_proc
--
 block
  decvar x: int
  --
  x := x;
  input x.x;
  output x + 67;
  dispose x.x.x.x[x->x->x];
  new u.v[x];
  u := 'una cadena!!!' + null;
  if 5 : end_if;
  if 5 : else end_if;
  while 5: end_while
 end_block
end_program 



  