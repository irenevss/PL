package alex;

import java_cup.runtime.Scanner;
import java_cup.runtime.Symbol;
import asint_cup.ClaseLexica;
import java.io.Reader;
import java.io.IOException;

import java_cup.runtime.ComplexSymbolFactory;
import java_cup.runtime.ComplexSymbolFactory.ComplexSymbol;

public class AnalizadorLexicoTinyCUP extends AnalizadorLexicoTiny implements Scanner {
    private ComplexSymbolFactory symbolFactory;

    public AnalizadorLexicoTinyCUP(Reader in) {
        super(in);
        symbolFactory = new ComplexSymbolFactory();
    }

    @Override
    public Symbol next_token() throws IOException {
        try {
            UnidadLexica ul = yylex();
            if (ul == null) {
                return symbolFactory.newSymbol("EOF", ClaseLexica.EOF);
            }
            int sym = mapClaseToId(ul.clase());
            return symbolFactory.newSymbol(ul.clase().toString(), sym,
                    new ComplexSymbolFactory.Location(ul.fila(), ul.columna()),
                    new ComplexSymbolFactory.Location(ul.fila(), ul.columna() + ul.lexema().length()),
                    ul.lexema());
        } catch (ALexOperations.ECaracterInesperado e) {
            throw new RuntimeException("ERROR_LEXICO");
        }
    }

    private int mapClaseToId(alex.ClaseLexica clase) {
        switch (clase) {
            case PROGRAM:
                return ClaseLexica.PROGRAM;
            case END_PROGRAM:
                return ClaseLexica.END_PROGRAM;
            case INT:
                return ClaseLexica.INT;
            case REAL:
                return ClaseLexica.REAL;
            case BOOL:
                return ClaseLexica.BOOL;
            case STRING:
                return ClaseLexica.STRING;
            case NULL:
                return ClaseLexica.NULL;
            case TRUE:
                return ClaseLexica.TRUE;
            case FALSE:
                return ClaseLexica.FALSE;
            case DECTYPE:
                return ClaseLexica.DECTYPE;
            case DECVAR:
                return ClaseLexica.DECVAR;
            case DECPROC:
                return ClaseLexica.DECPROC;
            case END_PROC:
                return ClaseLexica.END_PROC;
            case REF:
                return ClaseLexica.REF;
            case IF:
                return ClaseLexica.IF;
            case END_IF:
                return ClaseLexica.END_IF;
            case ELSE:
                return ClaseLexica.ELSE;
            case WHILE:
                return ClaseLexica.WHILE;
            case END_WHILE:
                return ClaseLexica.END_WHILE;
            case ARRAY:
                return ClaseLexica.ARRAY;
            case OF:
                return ClaseLexica.OF;
            case RECORD:
                return ClaseLexica.RECORD;
            case END_RECORD:
                return ClaseLexica.END_RECORD;
            case POINTER:
                return ClaseLexica.POINTER;
            case NEW:
                return ClaseLexica.NEW;
            case DISPOSE:
                return ClaseLexica.DISPOSE;
            case INPUT:
                return ClaseLexica.INPUT;
            case OUTPUT:
                return ClaseLexica.OUTPUT;
            case BLOCK:
                return ClaseLexica.BLOCK;
            case END_BLOCK:
                return ClaseLexica.END_BLOCK;
            case MAS:
                return ClaseLexica.MAS;
            case MENOS:
                return ClaseLexica.MENOS;
            case POR:
                return ClaseLexica.POR;
            case DIV:
                return ClaseLexica.DIV;
            case MOD:
                return ClaseLexica.MOD;
            case MENOR:
                return ClaseLexica.MENOR;
            case MAYOR:
                return ClaseLexica.MAYOR;
            case MENOR_IGUAL:
                return ClaseLexica.MENOR_IGUAL;
            case MAYOR_IGUAL:
                return ClaseLexica.MAYOR_IGUAL;
            case IGUAL:
                return ClaseLexica.IGUAL;
            case DISTINTO:
                return ClaseLexica.DISTINTO;
            case PAP:
                return ClaseLexica.PAP;
            case PCIERRE:
                return ClaseLexica.PCIERRE;
            case PUNTO_COMA:
                return ClaseLexica.PUNTO_COMA;
            case DOS_PUNTOS:
                return ClaseLexica.DOS_PUNTOS;
            case ASIGNACION:
                return ClaseLexica.ASIGNACION;
            case CAP:
                return ClaseLexica.CAP;
            case CCIERRE:
                return ClaseLexica.CCIERRE;
            case PUNTO:
                return ClaseLexica.PUNTO;
            case FLECHA:
                return ClaseLexica.FLECHA;
            case AND:
                return ClaseLexica.AND;
            case OR:
                return ClaseLexica.OR;
            case NOT:
                return ClaseLexica.NOT;
            case ARROBA:
                return ClaseLexica.ARROBA;
            case COMA:
                return ClaseLexica.COMA;
            case SEPARADOR:
                return ClaseLexica.SEPARADOR;
            case ID:
                return ClaseLexica.ID;
            case LITERAL_ENTERO:
                return ClaseLexica.LITERAL_ENTERO;
            case LITERAL_REAL:
                return ClaseLexica.LITERAL_REAL;
            case CADENA_LITERAL:
                return ClaseLexica.CADENA_LITERAL;
            case EOF:
                return ClaseLexica.EOF;
            default:
                return ClaseLexica.error;
        }
    }
}
