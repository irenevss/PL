package c_ast_ascendente;

import java_cup.runtime.*;
import errors.GestionErroresTiny;
import asint.SintaxisAbstractaTiny.*;

scan with {: 
  return getScanner().next_token(); 
:};

parser code {:
    private GestionErroresTiny errores;
    public void syntax_error(Symbol unidadLexica) {
        if (unidadLexica instanceof UnidadLexica) {
            errores.errorSintactico((UnidadLexica)unidadLexica);
        } else {
            System.err.println("Error sintáctico: símbolo inesperado " + unidadLexica);
        }
    }
:};

init with {:
   errores = new GestionErroresTiny();
   AnalizadorLexicoTiny alex = (AnalizadorLexicoTiny)getScanner();
   alex.fijaGestionErrores(errores);
:};

terminal PROGRAM, END_PROGRAM, INT, REAL, BOOL, STRING, NULL, TRUE, FALSE, 
         DECTYPE, DECVAR, DECPROC, END_PROC, REF, IF, END_IF, ELSE, WHILE, 
         END_WHILE, ARRAY, OF, RECORD, END_RECORD, POINTER, NEW, DISPOSE, 
         INPUT, OUTPUT, BLOCK, END_BLOCK, MAS, MENOS, POR, DIV, MOD, 
         MENOR, MAYOR, MENOR_IGUAL, MAYOR_IGUAL, IGUAL, DISTINTO, PAP, 
         PCIERRE, PUNTO_COMA, DOS_PUNTOS, ASIGNACION, CAP, CCIERRE, PUNTO, 
         FLECHA, AND, OR, NOT, ARROBA, COMA, SEPARADOR, ID, LITERAL_ENTERO, 
         LITERAL_REAL, CADENA_LITERAL;

non terminal Prog S;
non terminal LDec_0 LDec_0;
non terminal Instrs_0 Instrs_0;
non terminal LDec LDec;
non terminal Dec Dec;
non terminal Tipo Tipo;
non terminal ListaRecord ListaRecord;
non terminal CamposRecord CamposRecord;
non terminal LProcParams_0 ProcParams_0;
non terminal LProcParams ProcParams;
non terminal Param Param;
non terminal LInstr LInstr;
non terminal LInstr_0 LInstr_0;
non terminal Instr Instr;
non terminal LExps_0 ProcActualParams_0;
non terminal LExps ProcActualParams;
non terminal Exp E;

precedence left OR;
precedence left AND;
precedence left MENOR, MAYOR, MENOR_IGUAL, MAYOR_IGUAL, IGUAL, DISTINTO;
precedence left MAS, MENOS;
precedence left POR, DIV, MOD;
precedence right NOT;
precedence left CAP, PUNTO, FLECHA;

S ::= PROGRAM LDec_0:l1 Instrs_0:i1 END_PROGRAM {: RESULT = new Prog(l1, i1); :};

LDec_0 ::= LDec:l SEPARADOR {: RESULT = new Si_dec(l); :}
         | {: RESULT = new No_dec(); :};

LDec ::= LDec:l1 PUNTO_COMA Dec:d {: RESULT = new Muchas_decs(l1, d); :}
       | Dec:d {: RESULT = new Una_dec(d); :};

Dec ::= DECVAR ID:i DOS_PUNTOS Tipo:t {: UnidadLexica ul = (UnidadLexica)i; RESULT = new Dec_var(ul.lexema(), t, ul.fila(), ul.columna()); :}
      | DECTYPE ID:i DOS_PUNTOS Tipo:t {: UnidadLexica ul = (UnidadLexica)i; RESULT = new Dec_tipo(ul.lexema(), t, ul.fila(), ul.columna()); :}
      | DECPROC ID:i PAP ProcParams_0:p PCIERRE LDec_0:l Instrs_0:instr END_PROC {: UnidadLexica ul = (UnidadLexica)i; RESULT = new Dec_proc(ul.lexema(), p, l, instr, ul.fila(), ul.columna()); :};

Tipo ::= INT {: RESULT = new Tipo_int(); :}
       | REAL {: RESULT = new Tipo_real(); :}
       | BOOL {: RESULT = new Tipo_bool(); :}
       | STRING {: RESULT = new Tipo_string(); :}
       | ID:i {: UnidadLexica ul = (UnidadLexica)i; RESULT = new Tipo_id(ul.lexema(), ul.fila(), ul.columna()); :}
       | ARRAY CAP LITERAL_ENTERO:le CCIERRE OF Tipo:t {: UnidadLexica ul = (UnidadLexica)le; RESULT = new Tipo_array(ul.lexema(), t, ul.fila(), ul.columna()); :}
       | RECORD ListaRecord:lr END_RECORD {: RESULT = new Tipo_record(lr); :}
       | POINTER Tipo:t {: RESULT = new Tipo_pointer(t); :};

ListaRecord ::= ListaRecord:lr PUNTO_COMA CamposRecord:cr {: RESULT = new Muchos_camposrecord(lr, cr); :}
              | CamposRecord:cr {: RESULT = new Un_camporecord(cr); :};

CamposRecord ::= ID:i DOS_PUNTOS Tipo:t {: UnidadLexica ul = (UnidadLexica)i; RESULT = new CamposRecord(ul.lexema(), t, ul.fila(), ul.columna()); :};

ProcParams_0 ::= ProcParams:p {: RESULT = new Si_procparam(p); :}
               | {: RESULT = new No_procparam(); :};

ProcParams ::= ProcParams:p COMA Param:pa {: RESULT = new Muchos_procparam(p, pa); :}
             | Param:pa {: RESULT = new Un_procparam(pa); :};

Param ::= REF ID:i DOS_PUNTOS Tipo:t {: UnidadLexica ul = (UnidadLexica)i; RESULT = new Param_ref(ul.lexema(), t, ul.fila(), ul.columna()); :}
        | ID:i DOS_PUNTOS Tipo:t {: UnidadLexica ul = (UnidadLexica)i; RESULT = new Param_val(ul.lexema(), t, ul.fila(), ul.columna()); :};

Instrs_0 ::= LInstr:l {: RESULT = new Si_instr(l); :}
           | {: RESULT = new No_instr(); :};

LInstr ::= LInstr:l1 PUNTO_COMA Instr:i {: RESULT = new Muchas_instr(l1, i); :}
         | Instr:i {: RESULT = new Una_instr(i); :};

// LInstr_0 removed

Instr ::= E:e1 ASIGNACION E:e2 {: RESULT = new Instr_asig(e1, e2); :}
        | IF E:e DOS_PUNTOS Instrs_0:l END_IF {: RESULT = new Instr_if(e, l); :}
        | IF E:e DOS_PUNTOS Instrs_0:l1 ELSE Instrs_0:l2 END_IF {: RESULT = new Instr_ifelse(e, l1, l2); :}
        | WHILE E:e DOS_PUNTOS Instrs_0:l END_WHILE {: RESULT = new Instr_while(e, l); :}
        | INPUT E:e {: RESULT = new Instr_lectura(e); :}
        | OUTPUT E:e {: RESULT = new Instr_escritura(e); :}
        | NEW E:e {: RESULT = new Instr_reserva(e); :}
        | DISPOSE E:e {: RESULT = new Instr_liberacion(e); :}
        | ARROBA ID:i PAP ProcActualParams_0:p PCIERRE {: UnidadLexica ul = (UnidadLexica)i; RESULT = new Instr_invocar(ul.lexema(), p, ul.fila(), ul.columna()); :}
        | BLOCK LDec_0:l Instrs_0:i END_BLOCK {: RESULT = new Instr_compuesta(l, i); :};

ProcActualParams_0 ::= ProcActualParams:p {: RESULT = new Si_exps(p); :}
                     | {: RESULT = new No_exps(); :};

ProcActualParams ::= ProcActualParams:p COMA E:e {: RESULT = new Muchas_exps(p, e); :}
                   | E:e {: RESULT = new Una_exp(e); :};

E ::= E:e1 MAS:op E:e2 {: UnidadLexica ul = (UnidadLexica)op; RESULT = new Exp_suma(e1, e2, ul.fila(), ul.columna()); :}
    | E:e1 MENOS:op E:e2 {: UnidadLexica ul = (UnidadLexica)op; RESULT = new Exp_resta(e1, e2, ul.fila(), ul.columna()); :}
    | E:e1 POR:op E:e2 {: UnidadLexica ul = (UnidadLexica)op; RESULT = new Exp_mul(e1, e2, ul.fila(), ul.columna()); :}
    | E:e1 DIV:op E:e2 {: UnidadLexica ul = (UnidadLexica)op; RESULT = new Exp_div(e1, e2, ul.fila(), ul.columna()); :}
    | E:e1 MOD:op E:e2 {: UnidadLexica ul = (UnidadLexica)op; RESULT = new Exp_mod(e1, e2, ul.fila(), ul.columna()); :}
    | E:e1 MENOR:op E:e2 {: UnidadLexica ul = (UnidadLexica)op; RESULT = new Exp_menor(e1, e2, ul.fila(), ul.columna()); :}
    | E:e1 MAYOR:op E:e2 {: UnidadLexica ul = (UnidadLexica)op; RESULT = new Exp_mayor(e1, e2, ul.fila(), ul.columna()); :}
    | E:e1 MENOR_IGUAL:op E:e2 {: UnidadLexica ul = (UnidadLexica)op; RESULT = new Exp_menor_igual(e1, e2, ul.fila(), ul.columna()); :}
    | E:e1 MAYOR_IGUAL:op E:e2 {: UnidadLexica ul = (UnidadLexica)op; RESULT = new Exp_mayor_igual(e1, e2, ul.fila(), ul.columna()); :}
    | E:e1 IGUAL:op E:e2 {: UnidadLexica ul = (UnidadLexica)op; RESULT = new Exp_igual(e1, e2, ul.fila(), ul.columna()); :}
    | E:e1 DISTINTO:op E:e2 {: UnidadLexica ul = (UnidadLexica)op; RESULT = new Exp_distinto(e1, e2, ul.fila(), ul.columna()); :}
    | E:e1 AND:op E:e2 {: UnidadLexica ul = (UnidadLexica)op; RESULT = new Exp_and(e1, e2, ul.fila(), ul.columna()); :}
    | E:e1 OR:op E:e2 {: UnidadLexica ul = (UnidadLexica)op; RESULT = new Exp_or(e1, e2, ul.fila(), ul.columna()); :}
    | MENOS:op E:e {: UnidadLexica ul = (UnidadLexica)op; RESULT = new Exp_menos_unario(e, ul.fila(), ul.columna()); :} %prec NOT
    | NOT:op E:e {: UnidadLexica ul = (UnidadLexica)op; RESULT = new Exp_not(e, ul.fila(), ul.columna()); :}
    | POR:op E:e {: UnidadLexica ul = (UnidadLexica)op; RESULT = new Exp_asterisco_unario(e, ul.fila(), ul.columna()); :} %prec NOT
    | E:e CAP:op E:e0 CCIERRE {: UnidadLexica ul = (UnidadLexica)op; RESULT = new Exp_array(e, e0, ul.fila(), ul.columna()); :}
    | E:e PUNTO ID:i {: UnidadLexica ul = (UnidadLexica)i; RESULT = new Exp_campo(e, ul.lexema(), ul.fila(), ul.columna()); :}
    | E:e FLECHA ID:i {: UnidadLexica ul = (UnidadLexica)i; RESULT = new Exp_flecha(e, ul.lexema(), ul.fila(), ul.columna()); :}
    | ID:i {: UnidadLexica ul = (UnidadLexica)i; RESULT = new Iden(ul.lexema(), ul.fila(), ul.columna()); :}
    | LITERAL_ENTERO:le {: UnidadLexica ul = (UnidadLexica)le; RESULT = new Lit_int(ul.lexema(), ul.fila(), ul.columna()); :}
    | LITERAL_REAL:lr {: UnidadLexica ul = (UnidadLexica)lr; RESULT = new Lit_real(ul.lexema(), ul.fila(), ul.columna()); :}
    | TRUE:t {: UnidadLexica ul = (UnidadLexica)t; RESULT = new Lit_bool(ul.lexema(), ul.fila(), ul.columna()); :}
    | FALSE:f {: UnidadLexica ul = (UnidadLexica)f; RESULT = new Lit_bool(ul.lexema(), ul.fila(), ul.columna()); :}
    | CADENA_LITERAL:cl {: UnidadLexica ul = (UnidadLexica)cl; RESULT = new Lit_string(ul.lexema(), ul.fila(), ul.columna()); :}
    | NULL:n {: UnidadLexica ul = (UnidadLexica)n; RESULT = new Exp_null(ul.fila(), ul.columna()); :}
    | PAP E:e PCIERRE {: RESULT = e; :};
