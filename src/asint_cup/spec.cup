package asint_cup;

import java_cup.runtime.*;
import alex.AnalizadorLexicoTiny;
import alex.UnidadLexica;
import errors.GestionErroresTiny;
import ast.*;

scan with {: 
  return getScanner().next_token(); 
:};

parser code {:
    private GestionErroresTiny errores;
    public void syntax_error(Symbol unidadLexica) {
        if (unidadLexica instanceof UnidadLexica) {
            errores.errorSintactico((UnidadLexica)unidadLexica);
        } else {
            System.err.println("Error sintáctico: símbolo inesperado " + unidadLexica);
        }
    }
:};

init with {:
   errores = new GestionErroresTiny();
   AnalizadorLexicoTiny alex = (AnalizadorLexicoTiny)getScanner();
   alex.fijaGestionErrores(errores);
:};

terminal PROGRAM, END_PROGRAM, INT, REAL, BOOL, STRING, NULL, TRUE, FALSE, 
         DECTYPE, DECVAR, DECPROC, END_PROC, REF, IF, END_IF, ELSE, WHILE, 
         END_WHILE, ARRAY, OF, RECORD, END_RECORD, POINTER, NEW, DISPOSE, 
         INPUT, OUTPUT, BLOCK, END_BLOCK, MAS, MENOS, POR, DIV, MOD, 
         MENOR, MAYOR, MENOR_IGUAL, MAYOR_IGUAL, IGUAL, DISTINTO, PAP, 
         PCIERRE, PUNTO_COMA, DOS_PUNTOS, ASIGNACION, CAP, CCIERRE, PUNTO, 
         FLECHA, AND, OR, NOT, ARROBA, COMA, SEPARADOR, ID, LITERAL_ENTERO, 
         LITERAL_REAL, CADENA_LITERAL;

non terminal Prog S;
non terminal LDec_0 LDec_0;
non terminal Instrs_0 Instrs_0;
non terminal LDec LDec;
non terminal Dec Dec;
non terminal Tipo Tipo;
non terminal ListaRecord ListaRecord;
non terminal CamposRecord CamposRecord;
non terminal LProcParams_0 ProcParams_0;
non terminal LProcParams ProcParams;
non terminal Param Param;
non terminal LInstr LInstr;
non terminal LInstr_0 LInstr_0;
non terminal Instr Instr;
non terminal LExps_0 ProcActualParams_0;
non terminal LExps ProcActualParams;
non terminal Exp E;

precedence left OR;
precedence left AND;
precedence left MENOR, MAYOR, MENOR_IGUAL, MAYOR_IGUAL, IGUAL, DISTINTO;
precedence left MAS, MENOS;
precedence left POR, DIV, MOD;
precedence right NOT;
precedence left CAP, PUNTO, FLECHA;

S ::= PROGRAM LDec_0:l1 Instrs_0:i1 END_PROGRAM {: RESULT = new Prog(l1, i1); :};

LDec_0 ::= LDec:l SEPARADOR {: RESULT = new LDec_0.Si_dec(l); :}
         | {: RESULT = new LDec_0.No_dec(); :};

LDec ::= LDec:l1 PUNTO_COMA Dec:d {: RESULT = new LDec.Muchas_decs(l1, d); :}
       | Dec:d {: RESULT = new LDec.Una_dec(d); :};

Dec ::= DECVAR ID:i DOS_PUNTOS Tipo:t {: UnidadLexica ul = (UnidadLexica)i; RESULT = new Dec.Dec_var(ul.lexema(), t, ul.fila(), ul.columna()); :}
      | DECTYPE ID:i DOS_PUNTOS Tipo:t {: UnidadLexica ul = (UnidadLexica)i; RESULT = new Dec.Dec_tipo(ul.lexema(), t, ul.fila(), ul.columna()); :}
      | DECPROC ID:i PAP ProcParams_0:p PCIERRE LDec_0:l Instrs_0:instr END_PROC {: UnidadLexica ul = (UnidadLexica)i; RESULT = new Dec.Dec_proc(ul.lexema(), ul.fila(), ul.columna(), p, l, instr); :};

Tipo ::= INT {: RESULT = new Tipo.Tipo_int(); :}
       | REAL {: RESULT = new Tipo.Tipo_real(); :}
       | BOOL {: RESULT = new Tipo.Tipo_bool(); :}
       | STRING {: RESULT = new Tipo.Tipo_string(); :}
       | ID:i {: UnidadLexica ul = (UnidadLexica)i; RESULT = new Tipo.Tipo_id(ul.lexema(), ul.fila(), ul.columna()); :}
       | ARRAY CAP LITERAL_ENTERO:le CCIERRE OF Tipo:t {: UnidadLexica ul = (UnidadLexica)le; RESULT = new Tipo.Tipo_array(ul.lexema(), t, ul.fila(), ul.columna()); :}
       | RECORD ListaRecord:lr END_RECORD {: RESULT = new Tipo.Tipo_record(lr); :}
       | POINTER Tipo:t {: RESULT = new Tipo.Tipo_pointer(t); :};

ListaRecord ::= ListaRecord:lr PUNTO_COMA CamposRecord:cr {: RESULT = new ListaRecord.Muchos_camposrecord(lr, cr); :}
              | CamposRecord:cr {: RESULT = new ListaRecord.Un_camporecord(cr); :};

CamposRecord ::= ID:i DOS_PUNTOS Tipo:t {: UnidadLexica ul = (UnidadLexica)i; RESULT = new CamposRecord(ul.lexema(), t, ul.fila(), ul.columna()); :};

ProcParams_0 ::= ProcParams:p {: RESULT = new LProcParams_0.Si_procparam(p); :}
               | {: RESULT = new LProcParams_0.No_procparam(); :};

ProcParams ::= ProcParams:p COMA Param:pa {: RESULT = new LProcParams.Muchos_procparam(p, pa); :}
             | Param:pa {: RESULT = new LProcParams.Un_procparam(pa); :};

Param ::= REF ID:i DOS_PUNTOS Tipo:t {: UnidadLexica ul = (UnidadLexica)i; RESULT = new Param.Param_ref(ul.lexema(), t, ul.fila(), ul.columna()); :}
        | ID:i DOS_PUNTOS Tipo:t {: UnidadLexica ul = (UnidadLexica)i; RESULT = new Param.Param_val(ul.lexema(), t, ul.fila(), ul.columna()); :};

Instrs_0 ::= LInstr:l {: RESULT = new Instrs_0.Si_instr(l); :}
           | {: RESULT = new Instrs_0.No_instr(); :};

LInstr ::= LInstr:l1 PUNTO_COMA Instr:i {: RESULT = new LInstr.Muchas_instr(l1, i); :}
         | Instr:i {: RESULT = new LInstr.Una_instr(i); :};

LInstr_0 ::= LInstr:l {: RESULT = new LInstr_0.Si_instr_l(l); :}
           | {: RESULT = new LInstr_0.No_instr_l(); :};

Instr ::= E:e1 ASIGNACION E:e2 {: RESULT = new Instr.Instr_asig(e1, e2); :}
        | IF E:e DOS_PUNTOS LInstr_0:l END_IF {: RESULT = new Instr.Instr_if(e, l); :}
        | IF E:e DOS_PUNTOS LInstr_0:l1 ELSE LInstr_0:l2 END_IF {: RESULT = new Instr.Instr_ifelse(e, l1, l2); :}
        | WHILE E:e DOS_PUNTOS LInstr_0:l END_WHILE {: RESULT = new Instr.Instr_while(e, l); :}
        | INPUT E:e {: RESULT = new Instr.Instr_lectura(e); :}
        | OUTPUT E:e {: RESULT = new Instr.Instr_escritura(e); :}
        | NEW E:e {: RESULT = new Instr.Instr_reserva(e); :}
        | DISPOSE E:e {: RESULT = new Instr.Instr_liberacion(e); :}
        | ARROBA ID:i PAP ProcActualParams_0:p PCIERRE {: UnidadLexica ul = (UnidadLexica)i; RESULT = new Instr.Instr_invocar(ul.lexema(), p, ul.fila(), ul.columna()); :}
        | BLOCK LDec_0:l LInstr_0:i END_BLOCK {: RESULT = new Instr.Instr_compuesta(l, i); :};

ProcActualParams_0 ::= ProcActualParams:p {: RESULT = new LExps_0.Si_exps(p); :}
                     | {: RESULT = new LExps_0.No_exps(); :};

ProcActualParams ::= ProcActualParams:p COMA E:e {: RESULT = new LExps.Muchas_exps(p, e); :}
                   | E:e {: RESULT = new LExps.Una_exp(e); :};

E ::= E:e1 MAS E:e2 {: RESULT = new Exp.Exp_suma(e1, e2, 0, 0); :}
    | E:e1 MENOS E:e2 {: RESULT = new Exp.Exp_resta(e1, e2, 0, 0); :}
    | E:e1 POR E:e2 {: RESULT = new Exp.Exp_mul(e1, e2, 0, 0); :}
    | E:e1 DIV E:e2 {: RESULT = new Exp.Exp_div(e1, e2, 0, 0); :}
    | E:e1 MOD E:e2 {: RESULT = new Exp.Exp_mod(e1, e2, 0, 0); :}
    | E:e1 MENOR E:e2 {: RESULT = new Exp.Exp_menor(e1, e2, 0, 0); :}
    | E:e1 MAYOR E:e2 {: RESULT = new Exp.Exp_mayor(e1, e2, 0, 0); :}
    | E:e1 MENOR_IGUAL E:e2 {: RESULT = new Exp.Exp_menor_igual(e1, e2, 0, 0); :}
    | E:e1 MAYOR_IGUAL E:e2 {: RESULT = new Exp.Exp_mayor_igual(e1, e2, 0, 0); :}
    | E:e1 IGUAL E:e2 {: RESULT = new Exp.Exp_igual(e1, e2, 0, 0); :}
    | E:e1 DISTINTO E:e2 {: RESULT = new Exp.Exp_distinto(e1, e2, 0, 0); :}
    | E:e1 AND E:e2 {: RESULT = new Exp.Exp_and(e1, e2, 0, 0); :}
    | E:e1 OR E:e2 {: RESULT = new Exp.Exp_or(e1, e2, 0, 0); :}
    | MENOS E:e {: RESULT = new Exp.Exp_menos_unario(e, 0, 0); :} %prec NOT
    | NOT E:e {: RESULT = new Exp.Exp_not(e, 0, 0); :}
    | POR E:e {: RESULT = new Exp.Exp_asterisco_unario(e, 0, 0); :} %prec NOT
    | E:e CAP E:e0 CCIERRE {: RESULT = new Exp.Exp_array(e, e0, 0, 0); :}
    | E:e PUNTO ID:i {: UnidadLexica ul = (UnidadLexica)i; RESULT = new Exp.Exp_campo(e, ul.lexema(), ul.fila(), ul.columna()); :}
    | E:e FLECHA ID:i {: UnidadLexica ul = (UnidadLexica)i; RESULT = new Exp.Exp_flecha(e, ul.lexema(), ul.fila(), ul.columna()); :}
    | ID:i {: UnidadLexica ul = (UnidadLexica)i; RESULT = new Exp.Iden(ul.lexema(), ul.fila(), ul.columna()); :}
    | LITERAL_ENTERO:le {: UnidadLexica ul = (UnidadLexica)le; RESULT = new Exp.Lit_int(ul.lexema(), ul.fila(), ul.columna()); :}
    | LITERAL_REAL:lr {: UnidadLexica ul = (UnidadLexica)lr; RESULT = new Exp.Lit_real(ul.lexema(), ul.fila(), ul.columna()); :}
    | TRUE:t {: UnidadLexica ul = (UnidadLexica)t; RESULT = new Exp.Lit_bool(ul.lexema(), ul.fila(), ul.columna()); :}
    | FALSE:f {: UnidadLexica ul = (UnidadLexica)f; RESULT = new Exp.Lit_bool(ul.lexema(), ul.fila(), ul.columna()); :}
    | CADENA_LITERAL:cl {: UnidadLexica ul = (UnidadLexica)cl; RESULT = new Exp.Lit_string(ul.lexema(), ul.fila(), ul.columna()); :}
    | NULL:n {: UnidadLexica ul = (UnidadLexica)n; RESULT = new Exp.Exp_null(ul.fila(), ul.columna()); :}
    | PAP E:e PCIERRE {: RESULT = e; :};
