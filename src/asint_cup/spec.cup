package asint_cup;

import java_cup.runtime.*;
import alex.AnalizadorLexicoTiny;
import alex.UnidadLexica;
import errors.GestionErroresTiny;

scan with {: 
  return getScanner().next_token(); 
:};

parser code {:
    private GestionErroresTiny errores;
     private ASTNode ast;

     public void setAST(ASTNode ast) {
          this.ast = ast;
     }

     public ASTNode getAST() {
          return ast;
     }

    public void syntax_error(Symbol unidadLexica) {
        if (unidadLexica instanceof UnidadLexica) {
            errores.errorSintactico((UnidadLexica)unidadLexica);
        } else {
            System.err.println("Error sintáctico: símbolo inesperado " + unidadLexica);
        }
    }
:};

init with {:
   errores = new GestionErroresTiny();
   AnalizadorLexicoTiny alex = (AnalizadorLexicoTiny)getScanner();
   alex.fijaGestionErrores(errores);
:};

terminal UnidadLexica PROGRAM, END_PROGRAM, INT, REAL, BOOL, STRING, NULL, TRUE, FALSE,
                     DECTYPE, DECVAR, DECPROC, END_PROC, REF, IF, END_IF, ELSE, WHILE,
                     END_WHILE, ARRAY, OF, RECORD, END_RECORD, POINTER, NEW, DISPOSE,
                     INPUT, OUTPUT, BLOCK, END_BLOCK, MAS, MENOS, POR, DIV, MOD,
                     MENOR, MAYOR, MENOR_IGUAL, MAYOR_IGUAL, IGUAL, DISTINTO, PAP,
                     PCIERRE, PUNTO_COMA, DOS_PUNTOS, ASIGNACION, CAP, CCIERRE, PUNTO,
                     FLECHA, AND, OR, NOT, ARROBA, COMA, SEPARADOR, ID, LITERAL_ENTERO,
                     LITERAL_REAL, CADENA_LITERAL;

non terminal ASTNode S, LDec_0, Instrs_0, LDec, Dec, DecVar, DecTipo, DecProc,
                               Tipo, ListaRecord, CamposRecord, ProcParams_0,
                               ProcParams, Param, LInstr, Instr, InstrAsig,
                               InstrIf, InstrIfElse, InstrWhile, InstrLectura, InstrEscritura,
                               InstrReserva, InstrLiberacion, InstrInvocar, InstrCompuesta,
                               ProcActualParams_0, ProcActualParams, ActualParam,
                               E0, E1, E2, E3, E4, E5, E6;

non terminal UnidadLexica Op0, Op1, Op2;

S ::= PROGRAM:p LDec_0:ld Instrs_0:is END_PROGRAM:e
               {: RESULT = ASTNode.node("prog", ld, is); parser.setAST((ASTNode)RESULT); :}
               ;

LDec_0 ::= LDec:l SEPARADOR:s
                          {: RESULT = ASTNode.node("si_dec", l); :}
                     |
                          {: RESULT = ASTNode.node("no_dec"); :}
                     ;

LDec ::= LDec:l PUNTO_COMA Dec:d
                     {: RESULT = ASTNode.appendLeft("muchas_decs", l, d); :}
                | Dec:d
                     {: RESULT = ASTNode.node("una_dec", d); :}
                ;

Dec ::= DecVar:d
                    {: RESULT = d; :}
               | DecTipo:d
                    {: RESULT = d; :}
               | DecProc:d
                    {: RESULT = d; :}
               ;

Tipo ::= INT:t
                     {: RESULT = ASTNode.withToken("tipo_int", t); :}
                | REAL:t
                     {: RESULT = ASTNode.withToken("tipo_real", t); :}
                | BOOL:t
                     {: RESULT = ASTNode.withToken("tipo_bool", t); :}
                | STRING:t
                     {: RESULT = ASTNode.withToken("tipo_string", t); :}
                | ID:id
                     {: RESULT = ASTNode.withToken("tipo_id", id); :}
                | ARRAY:a CAP:cap LITERAL_ENTERO:n CCIERRE:c OF:o Tipo:t
                     {: RESULT = ASTNode.withLexemaAt("tipo_array", n.lexema(), c, t); :}
                | RECORD:r ListaRecord:lr END_RECORD:er
                     {: RESULT = ASTNode.withToken("tipo_record", r, lr); :}
                | POINTER:p Tipo:t
                     {: RESULT = ASTNode.withToken("tipo_pointer", p, t); :}
                ;

ListaRecord ::= ListaRecord:l PUNTO_COMA CamposRecord:c
                                        {: RESULT = ASTNode.appendLeft("muchos_camposrecord", l, c); :}
                                   | CamposRecord:c
                                        {: RESULT = ASTNode.node("un_camporecord", c); :}
                                   ;

CamposRecord ::= ID:id DOS_PUNTOS Tipo:t
                                         {: RESULT = ASTNode.withToken("camporecord", id, t); :}
                                         ;

DecVar ::= DECVAR:dv ID:id DOS_PUNTOS Tipo:t
                          {: RESULT = ASTNode.withToken("dec_var", id, t); :}
                          ;

DecTipo ::= DECTYPE:dt ID:id DOS_PUNTOS Tipo:t
                              {: RESULT = ASTNode.withToken("dec_tipo", id, t); :}
                              ;

DecProc ::= DECPROC:dp ID:id PAP ProcParams_0:pp PCIERRE LDec_0:ld Instrs_0:is END_PROC:ep
                              {: RESULT = ASTNode.withToken("dec_proc", id, pp, ld, is); :}
                              ;

ProcParams_0 ::= ProcParams:pp
                                         {: RESULT = ASTNode.node("si_procparam", pp); :}
                                    |
                                         {: RESULT = ASTNode.node("no_procparam"); :}
                                    ;

ProcParams ::= ProcParams:pp COMA Param:p
                                    {: RESULT = ASTNode.appendLeft("muchos_procparam", pp, p); :}
                               | Param:p
                                    {: RESULT = ASTNode.node("un_procparam", p); :}
                               ;

Param ::= REF:r ID:id DOS_PUNTOS Tipo:t
                         {: RESULT = ASTNode.withToken("param_ref", id, t); :}
                    | ID:id DOS_PUNTOS Tipo:t
                         {: RESULT = ASTNode.withToken("param_val", id, t); :}
                    ;

Instrs_0 ::= LInstr:l
                               {: RESULT = ASTNode.node("si_instr", l); :}
                          |
                               {: RESULT = ASTNode.node("no_instr"); :}
                          ;

LInstr ::= LInstr:l PUNTO_COMA Instr:i
                          {: RESULT = ASTNode.appendLeft("muchas_instr", l, i); :}
                     | Instr:i
                          {: RESULT = ASTNode.node("una_instr", i); :}
                     ;

Instr ::= InstrAsig:i
                         {: RESULT = i; :}
                    | InstrIf:i
                         {: RESULT = i; :}
                    | InstrIfElse:i
                         {: RESULT = i; :}
                    | InstrWhile:i
                         {: RESULT = i; :}
                    | InstrLectura:i
                         {: RESULT = i; :}
                    | InstrEscritura:i
                         {: RESULT = i; :}
                    | InstrReserva:i
                         {: RESULT = i; :}
                    | InstrLiberacion:i
                         {: RESULT = i; :}
                    | InstrInvocar:i
                         {: RESULT = i; :}
                    | InstrCompuesta:i
                         {: RESULT = i; :}
                    ;

InstrAsig ::= E0:l ASIGNACION:a E0:r
                                   {: RESULT = ASTNode.withToken("instr_asig", a, l, r); :}
                                   ;

InstrIf ::= IF:i E0:e DOS_PUNTOS Instrs_0:is END_IF:ei
                              {: RESULT = ASTNode.withToken("instr_if", i, e, is); :}
                              ;

InstrIfElse ::= IF:i E0:e DOS_PUNTOS Instrs_0:is1 ELSE:el Instrs_0:is2 END_IF:ei
                                        {: RESULT = ASTNode.withToken("instr_ifelse", i, e, is1, is2); :}
                                        ;

InstrWhile ::= WHILE:w E0:e DOS_PUNTOS Instrs_0:is END_WHILE:ew
                                    {: RESULT = ASTNode.withToken("instr_while", w, e, is); :}
                                    ;

InstrLectura ::= INPUT:i E0:e
                                         {: RESULT = ASTNode.withToken("instr_lectura", i, e); :}
                                         ;

InstrEscritura ::= OUTPUT:o E0:e
                                              {: RESULT = ASTNode.withToken("instr_escritura", o, e); :}
                                              ;

InstrReserva ::= NEW:n E0:e
                                         {: RESULT = ASTNode.withToken("instr_reserva", n, e); :}
                                         ;

InstrLiberacion ::= DISPOSE:d E0:e
                                                  {: RESULT = ASTNode.withToken("instr_liberacion", d, e); :}
                                                  ;

InstrInvocar ::= ARROBA:a ID:id PAP ProcActualParams_0:pp PCIERRE
                                         {: RESULT = ASTNode.withToken("instr_invocar", id, pp); :}
                                         ;

ProcActualParams_0 ::= ProcActualParams:p
                                                        {: RESULT = ASTNode.node("si_exps", p); :}
                                                   |
                                                        {: RESULT = ASTNode.node("no_exps"); :}
                                                   ;

ProcActualParams ::= ProcActualParams:pp COMA ActualParam:a
                                                   {: RESULT = ASTNode.appendLeft("muchas_exps", pp, a); :}
                                              | ActualParam:a
                                                   {: RESULT = ASTNode.node("una_exp", a); :}
                                              ;

ActualParam ::= E0:e
                                        {: RESULT = e; :}
                                        ;

InstrCompuesta ::= BLOCK:b LDec_0:ld Instrs_0:is END_BLOCK:eb
                                              {: RESULT = ASTNode.withToken("instr_compuesta", b, ld, is); :}
                                              ;

E0 ::= E1:l Op0:op E1:r
                {: RESULT = ASTNode.binaryFromToken(op, l, r); :}
           | E1:e
                {: RESULT = e; :}
           ;

Op0 ::= MENOR:op
                    {: RESULT = op; :}
               | MAYOR:op
                    {: RESULT = op; :}
               | MENOR_IGUAL:op
                    {: RESULT = op; :}
               | MAYOR_IGUAL:op
                    {: RESULT = op; :}
               | IGUAL:op
                    {: RESULT = op; :}
               | DISTINTO:op
                    {: RESULT = op; :}
               ;

E1 ::= E1:l Op1:op E2:r
                {: RESULT = ASTNode.binaryFromToken(op, l, r); :}
           | E2:l OR:op E2:r
                {: RESULT = ASTNode.binaryFromToken(op, l, r); :}
           | E2:e
                {: RESULT = e; :}
           ;

Op1 ::= MAS:op
                    {: RESULT = op; :}
               | MENOS:op
                    {: RESULT = op; :}
               ;

E2 ::= E2:l Op2:op E3:r
                {: RESULT = ASTNode.binaryFromToken(op, l, r); :}
           | E3:l AND:op E3:r
                {: RESULT = ASTNode.binaryFromToken(op, l, r); :}
           | E3:e
                {: RESULT = e; :}
           ;

Op2 ::= POR:op
                    {: RESULT = op; :}
               | DIV:op
                    {: RESULT = op; :}
               | MOD:op
                    {: RESULT = op; :}
               ;

E3 ::= MENOS:op E3:e
                {: RESULT = ASTNode.unaryFromToken(op, e); :}
           | NOT:op E4:e
                {: RESULT = ASTNode.unaryFromToken(op, e); :}
           | E4:e
                {: RESULT = e; :}
           ;

E4 ::= E4:base CAP:cap E0:index CCIERRE:cc
                {: RESULT = ASTNode.postArray(base, cap, index); :}
           | E4:base PUNTO:dot ID:id
                {: RESULT = ASTNode.postField(base, dot, id); :}
           | E4:base FLECHA:arrow ID:id
                {: RESULT = ASTNode.postArrow(base, arrow, id); :}
           | E5:e
                {: RESULT = e; :}
           ;

E5 ::= POR:op E5:e
                {: RESULT = ASTNode.unaryFromToken(op, e); :}
           | E6:e
                {: RESULT = e; :}
           ;

E6 ::= ID:id
                {: RESULT = ASTNode.withToken("iden", id); :}
           | LITERAL_ENTERO:n
                {: RESULT = ASTNode.withToken("lit_int", n); :}
           | LITERAL_REAL:r
                {: RESULT = ASTNode.withToken("lit_real", r); :}
           | TRUE:t
                {: RESULT = ASTNode.withToken("lit_bool", t); :}
           | FALSE:f
                {: RESULT = ASTNode.withToken("lit_bool", f); :}
           | CADENA_LITERAL:s
                {: RESULT = ASTNode.withToken("lit_string", s); :}
           | NULL:n
                {: RESULT = ASTNode.withToken("exp_null", n); :}
           | PAP E0:e PCIERRE
                {: RESULT = e; :}
           ;
